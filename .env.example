# Copy to .env and adjust. Never commit a real .env file.

# Server binding. Keep 127.0.0.1 for local use; Docker sets HOST=0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=3003

# "demo" (built-in phrase book only) or "provider" (OpenAI-compatible API).
# If unset: provider when OPENAI_API_KEY is present, otherwise demo.
AI_MODE=demo

# OpenAI-compatible provider settings (server-side only; never sent to the browser).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT_MS=20000

# Maximum characters accepted per translation request (1-20000).
MAX_TEXT_LENGTH=5000